from pathlib import Path

import pandas as pd
from sklearn.ensemble import RandomForestRegressor
from sklearn.model_selection import GridSearchCV
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

train = pd.read_csv(Path(__file__).resolve().parent.parent / "data" / "train.csv")
test = pd.read_csv(Path(__file__).resolve().parent.parent / "data" / "test.csv")
features = ['longitude','latitude','housing_median_age','total_rooms','total_bedrooms','population','households','median_income',]

X = train[features]
y = train['median_house_value']

X_test = test[features]
y_test_actual = test['median_house_value']

param_grid = {'n_estimators': [100, 200],'max_depth': [None, 6, 10, 20],'max_features': ['sqrt', 'log2', 1.0],'min_samples_leaf': [1, 2, 5],}

model = RandomForestRegressor(random_state=42)
grid = GridSearchCV(estimator=model,param_grid=param_grid,cv=3,scoring='r2',n_jobs=-1,)

grid.fit(X, y)

best_model = grid.best_estimator_
y_pred = best_model.predict(X_test)

r2 = r2_score(y_test_actual, y_pred)

print(f"Best params: {grid.best_params_}")
print("R2 Score:", r2)